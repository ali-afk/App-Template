	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@vitest/coverage-istanbul": "catalog:",
		"@wdio/cli": "^10.2.0",
		"@wdio/junit-reporter": "^10.2.0",
		"@wdio/local-runner": "^10.2.0",
		"@wdio/mocha-framework": "^10.2.0",
		"@wdio/spec-reporter": "^10.2.0",
		"@wdio/tauri-plugin": "^1.5.1",
		"@wdio/tauri-service": "^1.5.1",
		"browserslist": "^4.29.5",
		"lefthook": "^2.2.2",
		"lightningcss": "^1.33.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
