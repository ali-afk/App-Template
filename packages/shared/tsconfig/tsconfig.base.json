{
	"extends": ["./fragments/tsconfig.bundler", "./fragments/tsconfig.lint"],
	"include": ["${configDir}/**/*.ts"],
	"exclude": [
		"${configDir}/**/.out/**",
		"${configDir}/**/.cache/**",
		"${configDir}/**/node_modules/**"
	],
	"compilerOptions": {
		"types": [
			"bun",
			"vite-plus/test/globals",
			"@testing-library/jest-dom/vitest",
			"vite-plus/client"
		]
	}
}
